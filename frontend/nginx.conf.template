server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;

    # uploads go through here to the API; keep in step with spring.servlet.multipart
    client_max_body_size 30m;

    # idle browser connections are let go after 30s rather than nginx's 75s default,
    # so a thousand users do not park a thousand idle sockets each
    keepalive_timeout 30s;

    # Docker's own DNS by default (NGINX_RESOLVER). The upstream is a variable so nginx
    # starts even when the API is not up yet, and finds it again after the API restarts.
    resolver ${NGINX_RESOLVER} valid=30s ipv6=off;

    # every API call goes to the Spring app, path unchanged (it serves /api/...)
    location /api/ {
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # the router owns every other path, so anything not a real file falls through to index
    location / {
        try_files $uri $uri/ /index.html;
    }

    # the built assets are content-hashed by Vite, so they can be cached hard
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # index.html must never be cached, or a deploy does not reach anyone
    location = /index.html {
        add_header Cache-Control "no-store";
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
}
