# ProITBridge LMS: every switch the backend reads, in one place.
#
# Copy to .env and fill in. docker compose reads .env from this folder; for a local
# `mvn spring-boot:run`, export these in your shell instead. Anything left blank uses
# the default shown in backend/src/main/resources/application.yml.
#
# Zoom: meeting links are not configured here. Each room's link and passcode is set
# in the app (My one to ones, and Weekly sessions). Auto-pull of Zoom cloud
# recordings is not built yet.

# ---------------------------------------------------------------- must set to go live
# The server refuses to start with a development secret once LMS_BASE_URL is not
# localhost. Generate one with: openssl rand -base64 48
JWT_SECRET=
# Public address of the frontend. Used in mail links and the go-live secret check.
# docker compose: http://localhost:8081, or your public https address.
LMS_BASE_URL=http://localhost:5173
# Comma separated origins allowed to call the API. Usually the same as LMS_BASE_URL.
CORS_ORIGINS=http://localhost:5173
# Without Docker: the full connection string.
MONGODB_URI=mongodb://localhost:27017/pib_lms
# With docker compose: the database user and password (the URI is built from these).
MONGO_USER=pib
MONGO_PASSWORD=
# Port the site is served on by docker compose (http://localhost:8081 by default).
WEB_PORT=8081

# First super admin, created only when the database has no users at all.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_NAME=Super admin

# ---------------------------------------------------------------- mail
# false: every mail is written to the mail log screen and nothing is sent.
MAIL_ENABLED=false
MAIL_FROM=no-reply@proitbridge.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_TLS=true

# ---------------------------------------------------------------- AI (teach back, doubts, quiz drafts)
# Off or unreachable is fine: every AI feature falls back to a rule and nobody is blocked.
AI_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT=20

# ---------------------------------------------------------------- video
# YOUTUBE today. CLOUDFLARE_STREAM gives signed, expiring playback; fill all three below.
VIDEO_PROVIDER=YOUTUBE
CF_CUSTOMER_CODE=
CF_STREAM_KEY_ID=
# base64 of the PEM private key
CF_STREAM_PRIVATE_KEY=
# Optional: the onboarding walkthrough video link
LMS_WALKTHROUGH_URL=

# ---------------------------------------------------------------- files
FILES_PROVIDER=LOCAL
FILES_DIR=./data/files
FILES_MAX_BYTES=26214400

# ---------------------------------------------------------------- record sheet import
# A folder the server watches for the learner record sheet. Blank turns watching off.
IMPORT_WATCH_DIR=
IMPORT_WATCH_SECONDS=300
IMPORT_WATCH_MAIL=false

# ---------------------------------------------------------------- sign in limits
AUTH_MAX_PER_ACCOUNT=5
AUTH_LOCK_MINUTES=15
AUTH_MAX_PER_IP=20
AUTH_IP_WINDOW=1
AUTH_RESET_TTL=60
AUTH_MAX_RESETS=3
JWT_TTL_MINUTES=720

PORT=8080
